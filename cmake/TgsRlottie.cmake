# Builds vendored rlottie (Samsung, MIT + bundled licences) as an OBJECT library,
# so its objects end up INSIDE tgs-parse-imgui.lib (single .lib for the user).
# Options: no threads, no dynamic image-loader module, model cache on.

set(_rl "${CMAKE_CURRENT_LIST_DIR}/../third_party/rlottie")
get_filename_component(_rl "${_rl}" ABSOLUTE)

file(GLOB _rl_lottie  "${_rl}/src/lottie/*.cpp")
file(GLOB _rl_vector  "${_rl}/src/vector/*.cpp")
file(GLOB _rl_ft      "${_rl}/src/vector/freetype/*.cpp")

add_library(tgs_rlottie_obj OBJECT
    ${_rl_lottie}
    "${_rl}/src/lottie/zip/zip.cpp"
    ${_rl_vector}
    ${_rl_ft}
    "${_rl}/src/vector/stb/stb_image.cpp"
)

set(_rl_cfg_dir "${CMAKE_CURRENT_BINARY_DIR}/tgs_rlottie_config")
file(WRITE "${_rl_cfg_dir}/config.h.tmp"
"/* generated by tgs-parse-imgui */
#define LOTTIE_CACHE
#define LOTTIE_CACHE_SUPPORT
#define LOTTIE_IMAGE_MODULE_PLUGIN \"\"
")
configure_file("${_rl_cfg_dir}/config.h.tmp" "${_rl_cfg_dir}/config.h" COPYONLY)

target_include_directories(tgs_rlottie_obj PRIVATE
    "${_rl_cfg_dir}"
    "${_rl}/inc"
    "${_rl}/src/lottie"
    "${_rl}/src/lottie/zip"
    "${_rl}/src/vector"
    "${_rl}/src/vector/freetype"
    "${_rl}/src/vector/pixman"
    "${_rl}/src/vector/stb"
)
target_compile_definitions(tgs_rlottie_obj PRIVATE RLOTTIE_STATIC RLOTTIE_BUILD)
set_target_properties(tgs_rlottie_obj PROPERTIES
    CXX_STANDARD 14
    CXX_STANDARD_REQUIRED ON
    CXX_EXTENSIONS OFF
    POSITION_INDEPENDENT_CODE ON
)

if(MSVC)
    target_compile_options(tgs_rlottie_obj PRIVATE
        /W0 /utf-8 /EHs-c- /GR- /bigobj)
    target_compile_definitions(tgs_rlottie_obj PRIVATE
        _CRT_SECURE_NO_WARNINGS NOMINMAX WIN32_LEAN_AND_MEAN)
else()
    target_compile_options(tgs_rlottie_obj PRIVATE
        -w -fno-exceptions -fno-rtti -fvisibility=hidden -fvisibility-inlines-hidden)
endif()
