# Script mode helper for tgs_embed(): cmake -DTGS_MANIFEST=.. -DTGS_OUT_CPP=.. -DTGS_OUT_H=.. -DTGS_TARGET=.. -P TgsEmbedGen.cmake
cmake_minimum_required(VERSION 3.16)

foreach(v TGS_MANIFEST TGS_OUT_CPP TGS_OUT_H TGS_TARGET)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "TgsEmbedGen: ${v} not set")
    endif()
endforeach()

file(STRINGS "${TGS_MANIFEST}" lines)
string(MAKE_C_IDENTIFIER "${TGS_TARGET}" target_id)

set(_byte "0x[0-9a-f][0-9a-f],")
set(_row "")
foreach(i RANGE 1 24)
    string(APPEND _row "${_byte}")
endforeach()

# C string literal for asset name (escape everything that is not plain ASCII-safe)
function(_tgs_c_literal in out)
    if(in MATCHES "^[A-Za-z0-9_ ./+-]*$")
        set(${out} "\"${in}\"" PARENT_SCOPE)
    else()
        string(HEX "${in}" hex)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" esc "${hex}")
        set(${out} "\"${esc}\"" PARENT_SCOPE)
    endif()
endfunction()

set(cpp "// Auto-generated by tgs_embed(${TGS_TARGET}). Do not edit.\n")
string(APPEND cpp "#include <tgs/tgs_embed.h>\n#include <cstddef>\n\nnamespace {\n\n")
set(table "")
set(hdr_names "")
set(hdr_all "")
set(used_ids "")
set(idx 0)
set(total 0)

foreach(line IN LISTS lines)
    if(line STREQUAL "")
        continue()
    endif()
    string(FIND "${line}" "|" sep)
    string(SUBSTRING "${line}" 0 ${sep} name)
    math(EXPR p "${sep} + 1")
    string(SUBSTRING "${line}" ${p} -1 path)

    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    if(size EQUAL 0)
        message(FATAL_ERROR "tgs_embed: empty file ${path}")
    endif()
    math(EXPR total "${total} + ${size}")

    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${_row})" "\\1\n    " bytes "${bytes}")

    _tgs_c_literal("${name}" lit)
    string(APPEND cpp "// ${name}  <-  ${path}  (${size} bytes)\n")
    string(APPEND cpp "alignas(16) const unsigned char tgs_blob_${idx}[${size}] = {\n    ${bytes}\n};\n\n")
    string(APPEND table "    { ${lit}, tgs_blob_${idx}, ${size}u },\n")

    string(MAKE_C_IDENTIFIER "${name}" id)
    if(id IN_LIST used_ids)
        set(id "${id}_${idx}")
    endif()
    list(APPEND used_ids "${id}")
    string(APPEND hdr_names "    inline constexpr const char ${id}[] = ${lit};\n")
    string(APPEND hdr_all "        ${lit},\n")

    math(EXPR idx "${idx} + 1")
endforeach()

string(APPEND cpp "const ::tgs::EmbeddedAsset tgs_table[] = {\n${table}};\n\n")
string(APPEND cpp "// Static registration: runs when the DLL/EXE is loaded.\n")
string(APPEND cpp "const ::tgs::EmbeddedRegistrar tgs_registrar(tgs_table, sizeof(tgs_table) / sizeof(tgs_table[0]));\n\n")
string(APPEND cpp "} // namespace\n\n")
string(APPEND cpp "void tgs_register_assets_${target_id}()\n{\n")
string(APPEND cpp "    ::tgs::RegisterEmbedded(tgs_table, sizeof(tgs_table) / sizeof(tgs_table[0])); // idempotent\n}\n")

set(h "// Auto-generated by tgs_embed(${TGS_TARGET}). Do not edit.\n#pragma once\n#include <tgs/tgs_embed.h>\n\n")
string(APPEND h "// Explicit registration. Only needed if the target is a STATIC library\n")
string(APPEND h "// (the linker may drop the auto-registrar). Safe to call many times.\n")
string(APPEND h "void tgs_register_assets_${target_id}();\n")
string(APPEND h "#ifndef TGS_REGISTER_ASSETS\n#define TGS_REGISTER_ASSETS() tgs_register_assets_${target_id}()\n#endif\n\n")
string(APPEND h "namespace tgs_assets {\n${hdr_names}\n")
string(APPEND h "    inline constexpr int count = ${idx};\n")
string(APPEND h "    inline constexpr const char* all[] = {\n${hdr_all}    };\n")
string(APPEND h "    inline constexpr unsigned long long total_bytes = ${total}ull;\n} // namespace tgs_assets\n")

# write only if changed
foreach(pair "TGS_OUT_CPP;cpp" "TGS_OUT_H;h")
    list(GET pair 0 outvar)
    list(GET pair 1 contentvar)
    set(out "${${outvar}}")
    set(content "${${contentvar}}")
    set(old "")
    if(EXISTS "${out}")
        file(READ "${out}" old)
    endif()
    if(NOT old STREQUAL content)
        file(WRITE "${out}" "${content}")
    else()
        file(TOUCH_NOCREATE "${out}")
    endif()
endforeach()

message(STATUS "tgs: ${idx} sticker(s), ${total} bytes -> ${TGS_OUT_CPP}")
